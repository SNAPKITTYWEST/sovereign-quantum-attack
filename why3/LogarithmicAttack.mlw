(* LogarithmicAttack.mlw *)
(* Quantum-Logarithmic Complexity Attack Generator *)
(* Formal Verification of Theorem 5: Entropy-Amplification Recurrence *)

module LogarithmicAttack

  type lambda = float
  type entropy = float
  type theta = float

  axiom lambda_pos: forall l: lambda. l > 0.0
  axiom entropy_bound: forall h: entropy l: lambda. 0.0 <= h && h <= l

  let recurrence_h (l: lambda) (h: entropy) (t: theta) : entropy =
    h - (2.0 /. l) *. sqrt(h *. (l -. h)) *. sin(2.0 *. t)

  let recurrence_theta (l: lambda) (h: entropy) (t: theta) : theta =
    t + (1.0 /. l) *. sqrt(h *. (l -. h)) *. cos(2.0 *. t)

  type state = { l: lambda; h: entropy; t: theta }

  let amplify_step (s: state) : state =
    let l = s.l in
    let h = s.h in
    let t = s.t in
    { l = l;
      h = recurrence_h l h t;
      t = recurrence_theta l h t }

  let inv_entropy_bounded (s: state) =
    s.h >= 0.0 && s.h <= s.l

  let inv_prob_increasing (s1: state) (s2: state) =
    sin(s2.t)**2 >= sin(s1.t)**2

  lemma step_preserves_entropy:
    forall s: state.
      inv_entropy_bounded s ->
      inv_entropy_bounded (amplify_step s)
  proof { (* Alt-Ergo *) }

  lemma entropy_decays:
    forall s: state.
    (s.t > 0.0 && s.t < pi /. 2.0) ->
    (amplify_step s).h < s.h
  proof { (* Z3 *) }

end
